             ROW_NUMBER() OVER (PARTITION BY LTRIM(RTRIM(p.GithubRepoOwner)), LTRIM(RTRIM(p.GithubRepoName)) ORDER BY p.Id) AS n
      FROM Projects p WHERE LTRIM(RTRIM(p.GithubRepoOwner)) <> '' AND LTRIM(RTRIM(p.GithubRepoName)) <> '') x
