# Site público estático (prerender de Angular) en el hosting Linux: /es, /en, /it.
Options -Indexes -MultiViews
DirectoryIndex index.html
# Sin la redirección automática a la barra final (Apache la arma con http:// porque el SSL termina en Nginx):
# las carpetas de las páginas se sirven más abajo sin redirigir.
DirectorySlash Off

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS y sin www. El hosting termina SSL en Nginx: se mira también X-Forwarded-Proto para no entrar en bucle.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://rtres.net%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rtres.net%{REQUEST_URI} [L,R=301]

# La raíz va al español (mismo comportamiento que serve-site.mjs). URL absoluta: una relativa saldría con http://.
RewriteRule ^$ https://rtres.net/es/ [L,R=302]

# URL canónica de cada página: SIN "/" final (/es/nosotros), igual que los enlaces del sitio y el sitemap.
# El home de cada idioma sí lleva barra (/es/).
RewriteRule ^(es|en|it)$ https://rtres.net/$1/ [L,R=301]
# Versión con barra de una página interna -> sin barra (consolida enlaces viejos o externos).
RewriteRule ^(es|en|it)/(.+)/$ https://rtres.net/$1/$2 [L,R=301]
# Página prerenderizada: se sirve su index.html sin redirigir.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/index.html [END]

</IfModule>

# Todo está prerenderizado: lo que no existe devuelve un 404 real, con la página 404 del idioma de la URL.
# (En el raíz con <If>, no con un .htaccess por carpeta: ese anularía las reglas de reescritura de arriba.)
ErrorDocument 404 /es/404/index.html
<If "%{REQUEST_URI} =~ m#^/en/#">
ErrorDocument 404 /en/404/index.html
</If>
<If "%{REQUEST_URI} =~ m#^/it/#">
ErrorDocument 404 /it/404/index.html
</If>

# El HTML se revalida siempre; los .js/.css llevan hash en el nombre (build production) y pueden cachearse un año.
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
